-- Migration: Add coordinate fields to addresses and all order tables
-- This ensures all addresses and orders store latitude/longitude for location tracking

-- ============================================
-- 1. ADDRESSES TABLE
-- ============================================
-- Add latitude and longitude columns to addresses table
DO $$
BEGIN
  -- Add latitude column if it doesn't exist
  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns 
    WHERE table_schema = 'public' 
    AND table_name = 'addresses' 
    AND column_name = 'latitude'
  ) THEN
    ALTER TABLE public.addresses 
    ADD COLUMN latitude NUMERIC(10, 8) NULL;
    
    COMMENT ON COLUMN public.addresses.latitude IS 'Latitude coordinate of the address (decimal degrees)';
  END IF;

  -- Add longitude column if it doesn't exist
  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns 
    WHERE table_schema = 'public' 
    AND table_name = 'addresses' 
    AND column_name = 'longitude'
  ) THEN
    ALTER TABLE public.addresses 
    ADD COLUMN longitude NUMERIC(11, 8) NULL;
    
    COMMENT ON COLUMN public.addresses.longitude IS 'Longitude coordinate of the address (decimal degrees)';
  END IF;
END $$;

-- ============================================
-- 2. ORDERS TABLE (Regular orders)
-- ============================================
-- Add delivery_latitude and delivery_longitude columns
DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns 
    WHERE table_schema = 'public' 
    AND table_name = 'orders' 
    AND column_name = 'delivery_latitude'
  ) THEN
    ALTER TABLE public.orders 
    ADD COLUMN delivery_latitude NUMERIC(10, 8) NULL;
    
    COMMENT ON COLUMN public.orders.delivery_latitude IS 'Latitude coordinate of delivery address';
  END IF;

  IF NOT EXISTS (
    SELECT 1 FROM information_schema.columns 
    WHERE table_schema = 'public' 
    AND table_name = 'orders' 
    AND column_name = 'delivery_longitude'
  ) THEN
    ALTER TABLE public.orders 
    ADD COLUMN delivery_longitude NUMERIC(11, 8) NULL;
    
    COMMENT ON COLUMN public.orders.delivery_longitude IS 'Longitude coordinate of delivery address';
  END IF;
END $$;

