-- ============================================
-- NOTE: sixty_min_bulk_orders and sixty_min_mealbox_orders
-- already have delivery_latitude and delivery_longitude columns
-- (confirmed from schema files), so no changes needed for those tables
-- ============================================

-- ============================================
-- OPTIONAL: Create indexes for coordinate-based queries
-- ============================================
-- These indexes can help with location-based queries if needed in the future

-- Index on addresses coordinates (for geospatial queries)
CREATE INDEX IF NOT EXISTS idx_addresses_coordinates 
ON public.addresses(latitude, longitude) 
WHERE latitude IS NOT NULL AND longitude IS NOT NULL;

-- Index on orders coordinates
CREATE INDEX IF NOT EXISTS idx_orders_coordinates 
ON public.orders(delivery_latitude, delivery_longitude) 
WHERE delivery_latitude IS NOT NULL AND delivery_longitude IS NOT NULL;

-- Index on mealbox_orders coordinates
CREATE INDEX IF NOT EXISTS idx_mealbox_orders_coordinates 
ON public.mealbox_orders(delivery_latitude, delivery_longitude) 
WHERE delivery_latitude IS NOT NULL AND delivery_longitude IS NOT NULL;

-- Index on bulk_meal_orders coordinates
CREATE INDEX IF NOT EXISTS idx_bulk_meal_orders_coordinates 
ON public.bulk_meal_orders(delivery_latitude, delivery_longitude) 
WHERE delivery_latitude IS NOT NULL AND delivery_longitude IS NOT NULL;

-- Index on snack_box_orders coordinates
CREATE INDEX IF NOT EXISTS idx_snack_box_orders_coordinates 
ON public.snack_box_orders(delivery_latitude, delivery_longitude) 
WHERE delivery_latitude IS NOT NULL AND delivery_longitude IS NOT NULL;

-- Index on catering_orders coordinates
CREATE INDEX IF NOT EXISTS idx_catering_orders_coordinates 
ON public.catering_orders(delivery_latitude, delivery_longitude) 
WHERE delivery_latitude IS NOT NULL AND delivery_longitude IS NOT NULL;

-- Index on corporate_orders coordinates
CREATE INDEX IF NOT EXISTS idx_corporate_orders_coordinates 
ON public.corporate_orders(delivery_latitude, delivery_longitude) 
WHERE delivery_latitude IS NOT NULL AND delivery_longitude IS NOT NULL;
